# Copy to .env. Compose binds only localhost unless explicitly changed.
FORGE_BIND_ADDRESS=127.0.0.1
FORGE_PORT=8080

# Optional for localhost; set a long random token before exposing the service.
# The browser exchanges it for an HTTP-only session cookie.
API_TOKEN=

# Upload bytes and expanded virtual disk capacity are separate limits.
FORGE_MAX_UPLOAD_GIB=64
FORGE_MAX_VIRTUAL_GIB=2048

# Enable only for a trusted private S3-compatible endpoint (e.g. MinIO).
FORGE_ALLOW_PRIVATE_ENDPOINTS=false

# Software emulation works without /dev/kvm. See README for accelerated setup.
LIBGUESTFS_BACKEND_SETTINGS=force_tcg
# Required only with compose.kvm.yaml; use the host's `stat -c '%g' /dev/kvm`.
FORGE_KVM_GID=

# Server-side credentials; these are never entered into the browser.
# AWS SDK credential providers can also use a mounted profile/workload role.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Disable EC2 metadata lookup by default. Set false when deliberately using an EC2 role.
AWS_EC2_METADATA_DISABLED=true
